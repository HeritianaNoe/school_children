generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────── Enums ─────────
enum Role {
  ADMIN
  DIRECTOR
  MANAGER
  TEACHER
  STUDENT
}

enum Sex {
  M
  F
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum SessionStatus {
  PLANNED
  DONE
  CANCELLED
}

enum AssessmentType {
  HOMEWORK
  TEST
  EXAM
}

enum PayslipStatus {
  DRAFT
  VALIDATED
  PAID
}

// ───────── Auth / personnes ─────────
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role
  active       Boolean  @default(true)
  phone        String?
  photoUrl     String?
  sex          Sex? // utilisé pour l'avatar par défaut (les élèves ont leur propre champ sur Student)
  createdAt    DateTime @default(now())

  photo          UserPhoto?
  student        Student?
  teacher        Teacher?
  comments       Comment[]      @relation("CommentAuthor")
  notifications  Notification[]
  reclamations   Reclamation[]  @relation("ReclamationAuthor")
  announcements  Announcement[] @relation("AnnouncementAuthor")
}

// Photo de profil stockée en base (même principe que StudentPhoto ; les comptes élèves utilisent StudentPhoto)
model UserPhoto {
  userId    String   @id
  data      Bytes
  mime      String
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Student {
  id           String    @id @default(cuid())
  userId       String    @unique
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  matricule    String    @unique
  firstName    String
  lastName     String
  birthDate    DateTime?
  birthPlace   String?
  sex          Sex?
  address      String?
  phone        String?
  parentName   String?
  parentPhone  String?
  photoUrl     String?
  registeredAt DateTime  @default(now())

  classeId     String
  classe       Classe    @relation(fields: [classeId], references: [id])

  photo       StudentPhoto?
  attendances StudentAttendance[]
  grades      Grade[]
  comments    Comment[]           @relation("CommentStudent")

  @@index([classeId])
  @@index([lastName, firstName])
}

// Photo d'identité stockée en base (fonctionne sur tout hébergement, y compris sans disque persistant)
model StudentPhoto {
  studentId String   @id
  data      Bytes
  mime      String
  updatedAt DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Teacher {
  id         String  @id @default(cuid())
  userId     String  @unique
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  hourlyRate Decimal @db.Decimal(12, 2)

  courses     Course[]
  sessions    Session[]
  attendances TeacherAttendance[]
  payslips    Payslip[]
  comments    Comment[]           @relation("CommentTeacher")
}

// ───────── Structure pédagogique ─────────
model Classe {
  id       String    @id @default(cuid())
  name     String // ex: "6ème A"
  year     String // ex: "2026-2027"
  students Student[]
  courses  Course[]

  @@unique([name, year])
}

model Subject {
  id      String   @id @default(cuid())
  name    String   @unique
  courses Course[]
}

model Course {
  id          String  @id @default(cuid())
  classeId    String
  subjectId   String
  teacherId   String
  coefficient Float   @default(1)

  classe      Classe       @relation(fields: [classeId], references: [id])
  subject     Subject      @relation(fields: [subjectId], references: [id])
  teacher     Teacher      @relation(fields: [teacherId], references: [id])
  sessions    Session[]
  assessments Assessment[]
  slots       TimetableSlot[]

  @@unique([classeId, subjectId])
  @@index([teacherId])
}

// ───────── Emploi du temps (créneaux hebdomadaires récurrents) ─────────
model TimetableSlot {
  id        String  @id @default(cuid())
  courseId  String
  dayOfWeek Int // 1 = lundi … 6 = samedi
  startTime String // « HH:MM »
  endTime   String // « HH:MM »
  room      String?

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([dayOfWeek, startTime])
}

// ───────── Séances & présence ─────────
model Session {
  id        String        @id @default(cuid())
  courseId  String
  teacherId String
  startsAt  DateTime
  endsAt    DateTime
  status    SessionStatus @default(PLANNED)

  course            Course              @relation(fields: [courseId], references: [id])
  teacher           Teacher             @relation(fields: [teacherId], references: [id])
  studentAttendance StudentAttendance[]
  teacherAttendance TeacherAttendance?
  comments          Comment[]

  @@index([courseId, startsAt])
  @@index([teacherId, startsAt])
}

model StudentAttendance {
  id          String           @id @default(cuid())
  sessionId   String
  studentId   String
  status      AttendanceStatus
  minutesLate Int              @default(0)
  note        String?
  markedAt    DateTime         @default(now())

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id])

  @@unique([sessionId, studentId])
  @@index([studentId, markedAt])
}

model TeacherAttendance {
  id        String           @id @default(cuid())
  sessionId String           @unique
  teacherId String
  status    AttendanceStatus
  arrivedAt DateTime?
  leftAt    DateTime?
  note      String?

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  teacher Teacher @relation(fields: [teacherId], references: [id])

  @@index([teacherId])
}

// ───────── Notes ─────────
model Term {
  id          String       @id @default(cuid())
  name        String
  startDate   DateTime
  endDate     DateTime
  assessments Assessment[]
}

model Assessment {
  id          String         @id @default(cuid())
  courseId    String
  termId      String
  title       String
  type        AssessmentType
  maxScore    Float          @default(20)
  coefficient Float          @default(1)
  date        DateTime

  course Course  @relation(fields: [courseId], references: [id])
  term   Term    @relation(fields: [termId], references: [id])
  grades Grade[]
}

model Grade {
  id           String   @id @default(cuid())
  assessmentId String
  studentId    String
  score        Float?
  updatedAt    DateTime @updatedAt

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  student    Student    @relation(fields: [studentId], references: [id])

  @@unique([assessmentId, studentId])
}

// ───────── Commentaires ─────────
model Comment {
  id        String   @id @default(cuid())
  authorId  String
  body      String
  studentId String?
  teacherId String?
  sessionId String?
  createdAt DateTime @default(now())

  author  User     @relation("CommentAuthor", fields: [authorId], references: [id])
  student Student? @relation("CommentStudent", fields: [studentId], references: [id])
  teacher Teacher? @relation("CommentTeacher", fields: [teacherId], references: [id])
  session Session? @relation(fields: [sessionId], references: [id])

  @@index([studentId])
  @@index([teacherId])
}

// ───────── Notifications ─────────
model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String
  data      Json?
  dedupeKey String    @unique
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, readAt])
}

// ───────── Paie prof ─────────
model Payslip {
  id           String        @id @default(cuid())
  teacherId    String
  month        String
  totalMinutes Int
  hourlyRate   Decimal       @db.Decimal(12, 2)
  gross        Decimal       @db.Decimal(14, 2)
  status       PayslipStatus @default(DRAFT)
  createdAt    DateTime      @default(now())

  teacher Teacher @relation(fields: [teacherId], references: [id])

  @@unique([teacherId, month])
}

// ───────── Réclamations ─────────
model Reclamation {
  id          String   @id @default(cuid())
  authorId    String
  subject     String
  body        String
  status      String   @default("OPEN") // OPEN, IN_PROGRESS, CLOSED
  response    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  author User @relation("ReclamationAuthor", fields: [authorId], references: [id])

  @@index([authorId])
  @@index([status])
}

// ───────── Annonces ─────────
model Announcement {
  id          String   @id @default(cuid())
  authorId    String
  title       String
  body        String
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  author User @relation("AnnouncementAuthor", fields: [authorId], references: [id])

  @@index([createdAt])
}
