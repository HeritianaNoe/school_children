{
  "name": "school-app",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "db:push": "prisma db push && tsx scripts/db-constraints.ts",
    "db:reset": "prisma db push --force-reset && tsx scripts/db-constraints.ts && prisma db seed",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "alerts": "tsx scripts/run-alerts.ts",
    "students:sync": "tsx scripts/sync-student-accounts.ts"
  },
  "prisma": { "seed": "tsx prisma/seed.ts" },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "jose": "^5.9.6",
    "pdf-lib": "^1.17.1",
    "next": "14.2.15",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.16.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
